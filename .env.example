# Copy this file to .env in the repository root.
# FastAPI reads this file. Next.js does not.
# Never commit the copied .env file.

# Gemini authentication is Vertex AI through Application Default Credentials.
# Local: run gcloud auth application-default login and set the quota project.
# Cloud Run: attach a dedicated service identity with Vertex AI permission.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
# This model does not support global. Verify the model card before changing it.
GOOGLE_CLOUD_LOCATION=us-central1

# The Gemini model is server controlled. The browser cannot submit a model name.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# ADK uses this text model inside the Google Search function agent.
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Create a project API key in the OpenAI platform.
# FastAPI uses it for a short-lived Realtime client secret and hosted web search.
OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# The backend uses this model with the Responses API hosted web_search tool.
OPENAI_SEARCH_MODEL=gpt-5.6

# Exact, comma-separated browser origins. Do not use * or include URL paths.
ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=development

# Optional LangSmith tracing for Google ADK runs. Set LANGSMITH_TRACING=false
# (or omit the API key) to leave tracing off. Keep this key server-side.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=voice-lab
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OpenAI client-secret endpoint controls. Limits are per backend process.
SESSION_TOKEN_RATE_LIMIT=12
SESSION_TOKEN_CONCURRENCY=4

# OpenAI web-search function controls. Limits are per backend process.
WEB_SEARCH_RATE_LIMIT=30
WEB_SEARCH_CONCURRENCY=8

# Gemini ADK WebSocket controls. Limits are per backend process.
GEMINI_LIVE_RATE_LIMIT=8
GEMINI_LIVE_CONCURRENCY=8
GEMINI_LIVE_MAX_SECONDS=540

# Bounded streaming and abuse controls. The defaults match 16 kHz PCM16 input.
GEMINI_LIVE_QUEUE_FRAMES=16
GEMINI_LIVE_MAX_FRAME_BYTES=8192
GEMINI_LIVE_AUDIO_BYTES_PER_SECOND=40000
GEMINI_LIVE_AUDIO_BURST_BYTES=64000
